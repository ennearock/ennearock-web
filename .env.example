# Public application URL used for redirects and absolute links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project settings (safe to expose only the publishable key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only credentials. Never prefix these variables with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=

# Destination for contact inquiries and transactional sender identity.
CONTACT_TEAM_EMAIL=hello@ennearock.com
CONTACT_FROM_EMAIL=Ennearock <noreply@ennearock.com>
